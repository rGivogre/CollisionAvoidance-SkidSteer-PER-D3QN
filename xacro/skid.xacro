<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="robot">

    <xacro:include filename="inertial_macros.xacro"/>

    <material name="white">
        <color rgba="1 1 1 1" />
    </material> 

    <material name="orange">
        <color rgba="1 0.3 0.1 1" />
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1" />
    </material>

    <material name="black">
        <color rgba="0 0 0 1" />
    </material>

    <material name="red">
        <color rgba="1 0 0 1" />
    </material>

    <!-- Example link -->
    <link name="base_link">
    </link>

    <!-- CHASSIS LINK-->
    <joint name="chassis_joint" type="fixed">
        <parent link= "base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 0"/>
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="0 0 0.15"/>
            <geometry>
                <box size="1.0 0.6 0.3"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <box size="1.0 0.6 0.3"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="8.0" x="1.0" y="0.6" z="0.3">
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
        </xacro:inertial_box>  
    </link>

    <gazebo reference="chassis">
        <material>Gazebo/White</material>
    </gazebo>

    <!--FORWARD_LEFT LINK-->
    <joint name="fl_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="fl_wheel"/>
        <origin xyz="0.3 0.35 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="fl_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.15" length="0.1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.15" length="0.1"/>
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>8.0</mu>
                        <mu2>0.5</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
        <xacro:inertial_cylinder mass="2.0" length="0.1" radius="0.15">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="fl_wheel">
        <material>Gazebo/Blue</material>
        <mu1>20.0</mu1>
        <mu2>0.1</mu2>
        <kp>10000000.0</kp>
        <kd>1.0</kd>
        <minDepth>0.001</minDepth>
    </gazebo>

    <!--FORWARD_RIGHT LINK-->
    <joint name="fr_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="fr_wheel"/>
        <origin xyz="0.3 -0.35 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="fr_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.15" length="0.1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.15" length="0.1"/>
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>8.0</mu>
                        <mu2>0.5</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
        <xacro:inertial_cylinder mass="2.0" length="0.1" radius="0.15">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference="fr_wheel">
        <material>Gazebo/Blue</material>
        <mu1>20.0</mu1>
        <mu2>0.1</mu2>
        <kp>10000000.0</kp>
        <kd>1.0</kd>
        <minDepth>0.001</minDepth>
    </gazebo>

    <!--BACK_LEFT LINK-->
    <joint name="bl_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="bl_wheel"/>
        <origin xyz="-0.3 0.35 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="bl_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.15" length="0.1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.15" length="0.1"/>
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>8.0</mu>
                        <mu2>0.5</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
        <xacro:inertial_cylinder mass="2.0" length="0.1" radius="0.15">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference="bl_wheel">
        <material>Gazebo/Blue</material>
        <mu1>20.0</mu1>
        <mu2>0.1</mu2>
        <kp>10000000.0</kp>
        <kd>1.0</kd>
        <minDepth>0.001</minDepth>
    </gazebo>

    <!--BACK_RIGHT LINK-->
    <joint name="br_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="br_wheel"/>
        <origin xyz="-0.3 -0.35 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="br_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.15" length="0.1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.15" length="0.1"/>
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>8.0</mu>
                        <mu2>0.5</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
        <xacro:inertial_cylinder mass="2.0" length="0.1" radius="0.15">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference="br_wheel">
        <material>Gazebo/Blue</material>
        <mu1>20.0</mu1>
        <mu2>0.1</mu2>
        <kp>10000000.0</kp>
        <kd>1.0</kd>
        <minDepth>0.001</minDepth>
    </gazebo>

    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <origin xyz="0.3 0 0.32" rpy="0 0 0"/> </joint>

    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="laser_frame">
        <material>Gazebo/Black</material>
        <sensor name="laser" type="ray">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize> <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>512</samples>
                        <resolution>1</resolution>
                        <min_angle>-2.35619</min_angle>
                        <max_angle>2.35619</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>10</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <argument>~/out:=scan</argument> 
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>laser_frame</frame_name>
            </plugin>
        </sensor>
    </gazebo>

</robot>